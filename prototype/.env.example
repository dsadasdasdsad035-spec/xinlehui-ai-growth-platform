# 只配置在服务端。请勿把真实密钥写入前端或提交到 Git。
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# 已通过账号模型目录校验的视觉模型；如控制台接入点不同，请替换为你的 Endpoint ID。
ARK_VISION_MODEL=doubao-1-5-vision-pro-32k-250328
# 在方舟控制台创建或选择已开通的图片生成 / 图生图 Endpoint ID 后填写；例如 doubao-seedream 系列模型或你的 ep-... Endpoint。
ARK_IMAGE_MODEL=
AI_API_PORT=8787
